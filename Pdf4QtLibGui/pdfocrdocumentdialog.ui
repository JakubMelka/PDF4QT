              <widget class="QPushButton" name="removeLayerButton">
               <property name="text">
                <string>Remove OCR Layer from Checked Pages...</string>
               </property>
               <property name="toolTip">
                <string>Removes the OCR text layer created by PDF4QT including its private data. Other content is never removed.</string>
               </property>
               <property name="accessibleName">
                <string>Remove OCR Layer from Checked Pages</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox" name="compressionGroupBox">
               <property name="title">
                <string>Compress scanned images</string>
               </property>
               <layout class="QGridLayout" name="compressionLayout">
                <item row="0" column="0">
                 <widget class="QLabel" name="compressionModeLabel">
                  <property name="text">
                   <string>Mode:</string>
                  </property>
                  <property name="buddy">
                   <cstring>compressionModeComboBox</cstring>
                  </property>
                 </widget>
                </item>
                <item row="0" column="1" colspan="2">
                 <widget class="QComboBox" name="compressionModeComboBox">
                  <property name="accessibleName">
                   <string>Compression mode</string>
                  </property>
                  <property name="sizeAdjustPolicy">
                   <enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum>
                  </property>
                  <property name="minimumContentsLength">
                   <number>8</number>
