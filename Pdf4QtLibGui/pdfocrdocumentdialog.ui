                </property>
                <property name="accessibleName">
                 <string>Move Down</string>
                </property>
               </widget>
              </item>
              <item row="4" column="0">
               <widget class="QPushButton" name="editGeometryButton">
                <property name="text">
                 <string>Edit Box</string>
                </property>
                <property name="toolTip">
                 <string>Move or resize the box of the selected word in the page view</string>
                </property>
                <property name="accessibleName">
                 <string>Edit Box</string>
                </property>
                <property name="checkable">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item row="4" column="1" rowspan="1" colspan="2">
               <widget class="QPushButton" name="confirmAllButton">
                <property name="text">
                 <string>Confirm All on Page...</string>
                </property>
                <property name="toolTip">
                 <string>Confirm all words of the current page</string>
                </property>
                <property name="accessibleName">
                 <string>Confirm All on Page</string>
                </property>
               </widget>
              </item>
             </layout>
            </item>
           </layout>
          </widget>
         </item>
        </layout>
       </widget>
       <widget class="QWidget" name="findReplaceTab">
        <attribute name="title">
         <string>Find and replace</string>
        </attribute>
        <layout class="QVBoxLayout" name="findReplaceTabOuterLayout">
         <property name="leftMargin">
          <number>0</number>
         </property>
         <property name="topMargin">
          <number>0</number>
         </property>
         <property name="rightMargin">
          <number>0</number>
         </property>
         <property name="bottomMargin">
          <number>0</number>
         </property>
         <item>
          <widget class="QScrollArea" name="findReplaceTabScrollArea">
           <property name="frameShape">
            <enum>QFrame::NoFrame</enum>
           </property>
           <property name="widgetResizable">
            <bool>true</bool>
           </property>
           <widget class="QWidget" name="findReplaceTabContents">
            <layout class="QVBoxLayout" name="findReplaceTabLayout">
             <item>
              <widget class="QGroupBox" name="findReplaceGroupBox">
               <property name="title">
                <string>Find and replace in the OCR results</string>
               </property>
               <layout class="QGridLayout" name="findReplaceLayout">
                <item row="0" column="0">
                 <widget class="QLabel" name="findLabel">
                  <property name="text">
                   <string>&amp;Find:</string>
                  </property>
                  <property name="buddy">
                   <cstring>findEdit</cstring>
                  </property>
                 </widget>
                </item>
                <item row="0" column="1" rowspan="1" colspan="2">
                 <widget class="QLineEdit" name="findEdit">
                  <property name="accessibleName">
                   <string>Find</string>
                  </property>
                 </widget>
                </item>
                <item row="1" column="0">
                 <widget class="QLabel" name="replaceLabel">
                  <property name="text">
                   <string>&amp;Replace:</string>
                  </property>
                  <property name="buddy">
                   <cstring>replaceEdit</cstring>
                  </property>
                 </widget>
                </item>
                <item row="1" column="1" rowspan="1" colspan="2">
                 <widget class="QLineEdit" name="replaceEdit">
                  <property name="accessibleName">
                   <string>Replace with</string>
                  </property>
                 </widget>
                </item>
                <item row="2" column="0">
                 <widget class="QLabel" name="findScopeLabel">
                  <property name="text">
                   <string>Scope:</string>
                  </property>
                  <property name="buddy">
                   <cstring>findScopeComboBox</cstring>
                  </property>
                 </widget>
                </item>
                <item row="2" column="1" rowspan="1" colspan="2">
                 <widget class="QComboBox" name="findScopeComboBox">
                  <property name="accessibleName">
                   <string>Scope of the search</string>
                  </property>
                  <property name="sizeAdjustPolicy">
                   <enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum>
                  </property>
                  <property name="minimumContentsLength">
                   <number>8</number>
                  </property>
                 </widget>
                </item>
                <item row="3" column="0">
                 <widget class="QCheckBox" name="caseSensitiveCheckBox">
                  <property name="text">
                   <string>Case sensitive</string>
                  </property>
                  <property name="accessibleName">
                   <string>Case sensitive</string>
                  </property>
                 </widget>
                </item>
                <item row="3" column="1">
                 <widget class="QCheckBox" name="wholeWordsCheckBox">
                  <property name="text">
                   <string>Whole words</string>
                  </property>
                  <property name="accessibleName">
                   <string>Whole words</string>
                  </property>
                 </widget>
                </item>
                <item row="4" column="0">
                 <widget class="QPushButton" name="findNextButton">
                  <property name="text">
                   <string>Find Next</string>
                  </property>
                  <property name="accessibleName">
                   <string>Find Next</string>
                  </property>
                 </widget>
                </item>
                <item row="4" column="1">
                 <widget class="QPushButton" name="replaceAllButton">
                  <property name="text">
                   <string>Replace All...</string>
                  </property>
                  <property name="toolTip">
                   <string>Shows the number of occurrences and a preview before the replacement. The whole replacement is a single undo step.</string>
                  </property>
                  <property name="accessibleName">
                   <string>Replace All</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </widget>
             </item>
             <item>
              <spacer name="findReplaceTabSpacer">
               <property name="orientation">
                <enum>Qt::Vertical</enum>
               </property>
               <property name="sizeHint" stdset="0">
                <size>
                 <width>20</width>
                 <height>20</height>
                </size>
               </property>
              </spacer>
             </item>
            </layout>
           </widget>
          </widget>
         </item>
        </layout>
       </widget>
      </widget>
     </widget>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="progressLayout" stretch="1,1">
     <item>
      <widget class="QProgressBar" name="progressBar">
       <property name="accessibleName">
        <string>Progress</string>
       </property>
       <property name="value">
        <number>0</number>
       </property>
       <property name="textVisible">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="progressLabel">
       <property name="text">
        <string></string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="buttonsLayout">
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>20</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="recognizeButton">
       <property name="text">
        <string>Recogni&amp;ze Checked</string>
       </property>
       <property name="toolTip">
        <string>Recognize the checked pages. The document is not modified.</string>
       </property>
       <property name="accessibleName">
        <string>Recognize Checked</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="stopButton">
       <property name="text">
        <string>Sto&amp;p</string>
       </property>
       <property name="toolTip">
        <string>Stop the recognition. Finished results are kept.</string>
       </property>
       <property name="accessibleName">
        <string>Stop</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="applyButton">
       <property name="text">
        <string>Appl&amp;y to PDF...</string>
       </property>
       <property name="toolTip">
        <string>Write the invisible text layer into the document</string>
       </property>
       <property name="accessibleName">
        <string>Apply to PDF</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="exportButton">
       <property name="text">
        <string>E&amp;xport...</string>
       </property>
       <property name="toolTip">
        <string>Export the recognized text</string>
       </property>
       <property name="accessibleName">
        <string>Export</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="openProjectButton">
       <property name="text">
        <string>Open Pro&amp;ject...</string>
       </property>
       <property name="toolTip">
        <string>Open a saved OCR project</string>
       </property>
       <property name="accessibleName">
        <string>Open Project</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="saveProjectButton">
       <property name="text">
        <string>Save Project...</string>
       </property>
       <property name="toolTip">
        <string>Save the OCR project (results and corrections)</string>
       </property>
       <property name="accessibleName">
        <string>Save Project</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="closeButton">
       <property name="text">
        <string>Close</string>
       </property>
       <property name="accessibleName">
        <string>Close</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
