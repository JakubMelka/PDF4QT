               </property>
               <property name="accessibleName">
                <string>Write only reviewed words</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QCheckBox" name="keepReviewDataCheckBox">
               <property name="text">
                <string>Keep data for detailed review in the document</string>
               </property>
               <property name="toolTip">
                <string>Stores the original recognition, the scores and the review states in the PDF. Without this option, only the corrected text and its geometry are stored.</string>
               </property>
               <property name="accessibleName">
                <string>Keep data for detailed review in the document</string>
               </property>
              </widget>
             </item>
