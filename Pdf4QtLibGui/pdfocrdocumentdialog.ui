         </property>
         <item>
          <widget class="QScrollArea" name="imageTabScrollArea">
           <property name="frameShape">
            <enum>QFrame::NoFrame</enum>
           </property>
           <property name="widgetResizable">
            <bool>true</bool>
           </property>
           <widget class="QWidget" name="imageTabContents">
