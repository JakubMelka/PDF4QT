                   <widget class="QComboBox" name="exportFormatComboBox">
                    <property name="accessibleName">
                     <string>Export format</string>
                    </property>
                    <property name="toolTip">
                     <string>Plain text, or a structured format with the geometry of the words (hOCR, ALTO, TSV) for the archives and further processing.</string>
                    </property>
                    <property name="sizeAdjustPolicy">
                     <enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum>
                    </property>
                    <property name="minimumContentsLength">
                     <number>8</number>
                    </property>
                   </widget>
                  </item>
                 </layout>
                </item>
                <item>
                 <widget class="QStackedWidget" name="exportOptionsStack">
                  <widget class="QWidget" name="exportTextOptionsPage">
                   <layout class="QVBoxLayout" name="exportTextOptionsLayout">
                    <property name="leftMargin">
                     <number>0</number>
                    </property>
                    <property name="topMargin">
                     <number>0</number>
                    </property>
                    <property name="rightMargin">
