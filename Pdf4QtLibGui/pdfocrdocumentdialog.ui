                <widget class="QLabel" name="rotationLabel">
                 <property name="text">
                  <string>Rotation:</string>
                 </property>
                 <property name="buddy">
                  <cstring>rotationComboBox</cstring>
                 </property>
                </widget>
               </item>
               <item row="2" column="1">
                <widget class="QComboBox" name="rotationComboBox">
                 <property name="accessibleName">
                  <string>Rotation of the working image</string>
                 </property>
                 <property name="sizeAdjustPolicy">
                  <enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum>
                 </property>
                 <property name="minimumContentsLength">
                  <number>8</number>
                 </property>
                </widget>
               </item>
               <item row="3" column="0">
                <widget class="QLabel" name="binarizationLabel">
                 <property name="text">
                  <string>Binarization:</string>
                 </property>
                 <property name="buddy">
                  <cstring>binarizationComboBox</cstring>
                 </property>
                </widget>
               </item>
               <item row="3" column="1">
                <widget class="QComboBox" name="binarizationComboBox">
                 <property name="accessibleName">
                  <string>Binarization</string>
                 </property>
                 <property name="sizeAdjustPolicy">
                  <enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum>
                 </property>
                 <property name="minimumContentsLength">
                  <number>8</number>
                 </property>
                </widget>
               </item>
              </layout>
             </item>
             <item>
              <widget class="QLabel" name="memoryEstimateLabel">
               <property name="text">
                <string></string>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QCheckBox" name="autoOrientationCheckBox">
               <property name="text">
                <string>Detect the orientation automatically</string>
               </property>
               <property name="toolTip">
                <string>Detects the page orientation before the recognition. If there is not enough text, the orientation is kept; the manual rotation above is applied in addition.</string>
               </property>
               <property name="accessibleName">
                <string>Detect the orientation automatically</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QCheckBox" name="deskewCheckBox">
               <property name="text">
                <string>Straighten slightly skewed pages (deskew)</string>
               </property>
               <property name="toolTip">
                <string>Small skew is corrected in the working image only. The original page is never changed.</string>
               </property>
               <property name="accessibleName">
                <string>Straighten slightly skewed pages (deskew)</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QCheckBox" name="grayscaleCheckBox">
               <property name="text">
                <string>Convert to grayscale</string>
               </property>
               <property name="accessibleName">
                <string>Convert to grayscale</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QCheckBox" name="denoiseCheckBox">
               <property name="text">
                <string>Remove noise (mild)</string>
               </property>
               <property name="accessibleName">
                <string>Remove noise (mild)</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QCheckBox" name="invertCheckBox">
               <property name="text">
                <string>Invert (light text on dark background)</string>
               </property>
               <property name="accessibleName">
                <string>Invert (light text on dark background)</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QCheckBox" name="detectBlankPagesCheckBox">
               <property name="text">
                <string>Detect blank pages</string>
               </property>
               <property name="toolTip">
                <string>Pages without any ink are not recognized and get the state "No text found"</string>
               </property>
               <property name="accessibleName">
                <string>Detect blank pages</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QCheckBox" name="overrideBlankCheckBox">
               <property name="text">
                <string>Recognize the current page even if it looks blank</string>
               </property>
               <property name="accessibleName">
                <string>Recognize the current page even if it looks blank</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox" name="perspectiveGroupBox">
               <property name="title">
                <string>Perspective correction</string>
               </property>
               <layout class="QGridLayout" name="perspectiveLayout">
                <item row="0" column="0" colspan="2">
                 <widget class="QCheckBox" name="perspectiveCheckBox">
                  <property name="text">
                   <string>Correct the perspective of this page (photographed page)</string>
                  </property>
                  <property name="toolTip">
                   <string>The four corners of the document on the photo are mapped onto a rectangle. Only the working image of the recognition is corrected; the text layer is placed onto the photo.</string>
                  </property>
                  <property name="accessibleName">
                   <string>Correct the perspective of this page</string>
                  </property>
                 </widget>
                </item>
                <item row="1" column="0">
                 <widget class="QPushButton" name="perspectiveEditButton">
                  <property name="text">
                   <string>Set Corners...</string>
                  </property>
                  <property name="toolTip">
                   <string>Drag the four corners of the document in the original view; Enter confirms, Escape cancels</string>
                  </property>
                 </widget>
                </item>
                <item row="1" column="1">
                 <widget class="QPushButton" name="perspectiveResetButton">
                  <property name="text">
                   <string>Reset Corners</string>
                  </property>
                  <property name="toolTip">
                   <string>Place the corners onto the corners of the page</string>
                  </property>
                 </widget>
                </item>
                <item row="2" column="0">
                 <widget class="QPushButton" name="perspectiveCopyButton">
                  <property name="text">
                   <string>Use for Checked Pages</string>
                  </property>
                  <property name="toolTip">
                   <string>Use the corners for the checked pages of the same size (a camera on a stand distorts all pages the same way)</string>
                  </property>
                 </widget>
                </item>
                <item row="2" column="1">
                 <widget class="QCheckBox" name="perspectivePreviewCheckBox">
                  <property name="text">
                   <string>Show the corrected image</string>
                  </property>
                  <property name="toolTip">
                   <string>Show only the working image with the corrected perspective; the overlay of the words is hidden</string>
                  </property>
                 </widget>
                </item>
                <item row="3" column="0" colspan="2">
                 <widget class="QLabel" name="perspectiveInfoLabel">
                  <property name="text">
                   <string/>
                  </property>
                  <property name="wordWrap">
                   <bool>true</bool>
                  </property>
                 </widget>
                </item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="imageNoteLabel">
               <property name="text">
                <string>These operations change only the working image of the recognition, never the appearance of the PDF document. Annotations and form fields are not part of the working image.</string>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item>
              <spacer name="imageTabSpacer">
               <property name="orientation">
                <enum>Qt::Vertical</enum>
               </property>
               <property name="sizeHint" stdset="0">
                <size>
                 <width>20</width>
                 <height>20</height>
                </size>
               </property>
              </spacer>
             </item>
            </layout>
           </widget>
          </widget>
         </item>
        </layout>
       </widget>
