# Writes data of the sources of Pdf4QtLibFluent into a header of
# UnitTestsFluentLifetime:
# - the classes with the macro of the meta objects of Qt (headers and sources);
#   the test checks, that each class of the library has a sample on a page of
#   the gallery (or a justified exclusion),
# - the signals emitted by the code of the library (the class, whose function
#   emits it, and the name of the signal); the test deletes objects from inside
#   of the signals of the bases of Qt of a class of the library only, when the
#   library emits them itself (Qt uses many of its objects after its signals).
#
# Usage: cmake -DSOURCE_DIR=<Pdf4QtLibFluent/sources> -DOUTPUT=<header> -P fluentclasses.cmake

cmake_policy(VERSION 3.16)

file(GLOB FLUENT_FILES "${SOURCE_DIR}/*.h" "${SOURCE_DIR}/*.cpp")
list(SORT FLUENT_FILES)

set(FLUENT_CLASSES "")
foreach(FLUENT_FILE IN LISTS FLUENT_FILES)
    file(READ "${FLUENT_FILE}" FLUENT_CONTENT)
    # class [EXPORT] Name [final] : bases { Q_OBJECT - a match contains no
    # semicolon and no bracket (the separators of the lists of CMake)
    string(REGEX MATCHALL "class[ \t\r\n]+[A-Za-z0-9_ \t\r\n]*:[^][{}();]*{[ \t\r\n]*Q_OBJECT" FLUENT_MATCHES "${FLUENT_CONTENT}")
    foreach(FLUENT_MATCH IN LISTS FLUENT_MATCHES)
        string(REGEX REPLACE "^class[ \t\r\n]+([A-Za-z0-9_ \t\r\n]*):.*$" "\\1" FLUENT_NAME "${FLUENT_MATCH}")
        string(REGEX REPLACE "PDF4QTLIBFLUENTSHARED_EXPORT|final" " " FLUENT_NAME "${FLUENT_NAME}")
        string(STRIP "${FLUENT_NAME}" FLUENT_NAME)
        get_filename_component(FLUENT_FILE_NAME "${FLUENT_FILE}" NAME)
        list(APPEND FLUENT_CLASSES "    { \"pdf::${FLUENT_NAME}\", \"${FLUENT_FILE_NAME}\" },")
    endforeach()
endforeach()

set(FLUENT_EMITS "")
foreach(FLUENT_FILE IN LISTS FLUENT_FILES)
    if(NOT FLUENT_FILE MATCHES "\\.cpp$")
        continue()
    endif()
    # Heads of the functions (at the first column, "Class::function(") and the emits
    file(STRINGS "${FLUENT_FILE}" FLUENT_LINES REGEX "^[A-Za-z].*[A-Za-z0-9_]::~?[A-Za-z_][A-Za-z0-9_]*\\(|Q_EMIT [A-Za-z_][A-Za-z0-9_]*\\(")
    set(FLUENT_FUNCTION_CLASS "")
    foreach(FLUENT_LINE IN LISTS FLUENT_LINES)
        if(FLUENT_LINE MATCHES "Q_EMIT ([A-Za-z_][A-Za-z0-9_]*)\\(")
            set(FLUENT_ENTRY "    { \"pdf::${FLUENT_FUNCTION_CLASS}\", \"${CMAKE_MATCH_1}\" },")
            if(NOT FLUENT_FUNCTION_CLASS STREQUAL "" AND NOT FLUENT_ENTRY IN_LIST FLUENT_EMITS)
                list(APPEND FLUENT_EMITS "${FLUENT_ENTRY}")
            endif()
        elseif(FLUENT_LINE MATCHES "^([A-Za-z_][A-Za-z0-9_]*)::~?[A-Za-z_][A-Za-z0-9_]*\\(")
            set(FLUENT_FUNCTION_CLASS "${CMAKE_MATCH_1}")
        elseif(FLUENT_LINE MATCHES "^[A-Za-z].*[^A-Za-z0-9_:]([A-Za-z_][A-Za-z0-9_]*)::~?[A-Za-z_][A-Za-z0-9_]*\\(")
            set(FLUENT_FUNCTION_CLASS "${CMAKE_MATCH_1}")
        endif()
    endforeach()
endforeach()

list(LENGTH FLUENT_CLASSES FLUENT_COUNT)
list(LENGTH FLUENT_EMITS FLUENT_EMIT_COUNT)
if(FLUENT_COUNT EQUAL 0 OR FLUENT_EMIT_COUNT EQUAL 0)
    message(FATAL_ERROR "fluentclasses.cmake: no class or no signal found in ${SOURCE_DIR}")
endif()

string(REPLACE ";" "\n" FLUENT_LINES "${FLUENT_CLASSES}")
string(REPLACE ";" "\n" FLUENT_EMIT_LINES "${FLUENT_EMITS}")
set(FLUENT_HEADER "// Generated by UnitTests/fluentclasses.cmake from the sources of Pdf4QtLibFluent, do not edit\n\n#ifndef FLUENTLIFETIMECLASSES_H\n#define FLUENTLIFETIMECLASSES_H\n\nstruct FluentLibraryClass\n{\n    const char* className;\n    const char* fileName;\n};\n\nstatic const FluentLibraryClass FLUENT_LIBRARY_CLASSES[] =\n{\n${FLUENT_LINES}\n};\n\nstruct FluentLibraryEmit\n{\n    const char* className;\n    const char* signalName;\n};\n\nstatic const FluentLibraryEmit FLUENT_LIBRARY_EMITS[] =\n{\n${FLUENT_EMIT_LINES}\n};\n\n#endif // FLUENTLIFETIMECLASSES_H\n")

# The file is written only when its content changes (the test is not compiled again otherwise)
set(FLUENT_OLD_HEADER "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" FLUENT_OLD_HEADER)
endif()
if(NOT FLUENT_OLD_HEADER STREQUAL FLUENT_HEADER)
    file(WRITE "${OUTPUT}" "${FLUENT_HEADER}")
endif()
