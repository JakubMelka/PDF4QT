{
    "app-id": "io.github.JakubMelka.Pdf4qt",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "runtime-branch": "stable",
    "sdk": "org.kde.Sdk",
    "sdk-branch": "stable",
    "command": "Pdf4QtEditor",
    "finish-args": [
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--filesystem=host",
        "--filesystem=xdg-run/speech-dispatcher",
        "--filesystem=xdg-cache/speech-dispatcher",
        "--talk-name=org.freedesktop.speech-dispatcher"
    ],
    "cleanup": [
    ],
    "build-options": {
      "env": {
        "PKG_CONFIG_PATH": "/app/lib64/pkgconfig:/app/lib/pkgconfig"
      }
    },
    "modules": [
        {
            "name": "tbb",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DTBB_TEST=OFF",
                "-DTBB_EXAMPLES=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/uxlfoundation/oneTBB.git",
                    "tag": "v2023.1.0",
                    "commit": "3046c8b0c29df995980003ea24f4d78c80ec0c8d"
                }
            ]
        },
        {
            "name": "lcms2",
            "buildsystem": "meson",
            "config-opts": [
                "--buildtype=release",
                "-Dtests=disabled",
                "-Djpeg=disabled",
                "-Dtiff=disabled"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/mm2/Little-CMS.git",
                    "tag": "lcms2.19.1",
                    "commit": "21c582a594fe5279f90c0b93437c398f93bf62b0"
                }
            ]
        },
        {
            "name": "zlib",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DZLIB_BUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/madler/zlib.git",
                    "tag": "v1.3.2",
                    "commit": "da607da739fa6047df13e66a2af6b8bec7c2a498"
                }
            ]
        },
        {
            "name": "openjpeg",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_CODEC=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/uclouvain/openjpeg.git",
                    "tag": "v2.5.4",
                    "commit": "6c4a29b00211eb0430fa0e5e890f1ce5c80f409f"
                }
            ]
        },
        {
            "name": "clipper2",
            "buildsystem": "cmake-ninja",
            "subdir": "CPP",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCLIPPER2_EXAMPLES=OFF",
                "-DCLIPPER2_TESTS=OFF",
                "-DCLIPPER2_UTILS=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/AngusJohnson/Clipper2.git",
                    "tag": "Clipper2_2.0.1",
                    "commit": "21ebba05db8894f0c7217ad35ea518080f324946"
                },
                {
                    "type": "shell",
                    "commands": [
                        "sed -i 's/int ec;/int ec = 0;/' CPP/Clipper2Lib/src/clipper.triangulation.cpp"
                    ]
                }
            ]
        },
        {
            "name": "asmjit",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/asmjit/asmjit.git",
                    "commit": "c87860217e43e2a06060fcaae5b468f6a55b9963"
                }
            ]
        },
        {
            "name": "blend2d",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBLEND2D_EXTERNAL_ASMJIT=ON"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/blend2d/blend2d.git",
                    "commit": "6dbc2cefbc996379e07104e34519a440b49b15d7"
                }
            ]
        },
        {
            "name": "dotconf",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-static"
            ],
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/williamh/dotconf.git",
                    "tag": "v1.4.1",
                    "commit": "7c3e0515c29efce45de6aae29befb2ab4396bd60"
                },
                {
                    "type": "shell",
                    "commands": [
                        "autoreconf -fi"
                    ]
                }
            ]
        },
        {
            "name": "speech-dispatcher",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-static",
                "--disable-python",
                "--disable-doc",
                "--without-espeak",
                "--without-espeak-ng",
                "--without-flite",
                "--without-ibmtts",
                "--without-voxin",
                "--without-ivona",
                "--without-pico",
                "--without-baratinoo",
                "--without-kali",
                "--without-libao",
                "--without-pipewire",
                "--without-alsa",
                "--without-oss",
                "--without-nas",
                "--with-pulse",
                "--with-systemdsystemunitdir=no",
                "--with-systemduserunitdir=no"
            ],
            "cleanup": [
                "/bin",
                "/etc",
                "/include",
                "/libexec",
                "/share",
                "/lib/pkgconfig",
                "/lib/speech-dispatcher",
                "/lib/speech-dispatcher-modules",
                "/lib/*.la",
                "/lib/libspeechd.so",
                "/lib/libspeechd_module.so*"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/brailcom/speechd/releases/download/0.12.1/speech-dispatcher-0.12.1.tar.gz",
                    "sha256": "b14a5238d287d2dcce4dd42bbd66ca65fa228e7e683708267f7b34036f7ba4b4"
                }
            ]
        },
        {
            "name": "qtspeech-speechd",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DFEATURE_speechd=ON",
                "-DFEATURE_flite=OFF",
                "-DQT_BUILD_TESTS=OFF",
                "-DQT_BUILD_EXAMPLES=OFF"
            ],
            "cleanup": [
                "/include",
                "/lib/x86_64-linux-gnu",
                "/lib/cmake",
                "/lib/metatypes",
                "/lib/modules",
                "/lib/pkgconfig",
                "/lib/qml",
                "/lib/sbom",
                "/lib/*.prl",
                "/lib/libQt6TextToSpeech*",
                "/lib/plugins/texttospeech/libqtexttospeech_mock.so",
                "/mkspecs",
                "/modules",
                "/share",
                "/sbom"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.qt.io/official_releases/qt/6.11/6.11.2/submodules/qtspeech-everywhere-src-6.11.2.tar.xz",
                    "sha256": "9c1d05dc9d710049f20a67680fc6b4293c9b584a90f04f4cf6cc36e758c5cb98"
                }
            ]
        },
        {
            "name": "pdf4qt",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "cflags-cpp": ["-DPDF4QT_FLATPAK_BUILD"],
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DPDF4QT_INSTALL_QT_DEPENDENCIES=OFF",
                "-DPDF4QT_INSTALL_DEPENDENCIES=OFF",
                "-DPDF4QT_INSTALL_TO_USR=OFF",
                "-DCMAKE_VERBOSE_MAKEFILE=OFF"
            ],
            "build-commands": [
              "ninja all",
              "ninja release_translations"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/JakubMelka/PDF4QT.git",
                    "commit": "PDF4QT_LAST_COMMIT"
                }
            ]
        }
    ]
}

